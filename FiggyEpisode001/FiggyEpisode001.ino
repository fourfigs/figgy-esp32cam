bool initCamera() {
  camera_config_t c = {};
  c.ledc_channel = LEDC_CHANNEL_0;
  c.ledc_timer = LEDC_TIMER_0;
  c.pin_d0=5; c.pin_d1=18; c.pin_d2=19; c.pin_d3=21;
  c.pin_d4=36; c.pin_d5=39; c.pin_d6=34; c.pin_d7=35;
  c.pin_xclk=0; c.pin_pclk=22; c.pin_vsync=25; c.pin_href=23;
  c.pin_sccb_sda=26; c.pin_sccb_scl=27; c.pin_pwdn=32; c.pin_reset=-1;
  pinMode(4, OUTPUT); digitalWrite(4, LOW);
  c.xclk_freq_hz=20000000;
  c.pixel_format=PIXFORMAT_JPEG;
  const bool psram=psramFound();
  c.frame_size=psram?FRAMESIZE_VGA:FRAMESIZE_QVGA;
  c.jpeg_quality=12;
  c.fb_count=psram?2:1;
  c.fb_location=psram?CAMERA_FB_IN_PSRAM:CAMERA_FB_IN_DRAM;
  c.grab_mode=psram?CAMERA_GRAB_LATEST:CAMERA_GRAB_WHEN_EMPTY;
  esp_err_t err=esp_camera_init(&c);
  if(err!=ESP_OK){Serial.printf("Camera init failed: 0x%x\n",err);return false;}
  sensor_t* sensor=esp_camera_sensor_get();
  if(!sensor){esp_camera_deinit();return false;}
  Serial.printf("Camera PID: 0x%04x; PSRAM: %s\n",sensor->id.PID,psram?"yes":"no");
  if(sensor->id.PID==OV3660_PID){
    sensor->set_vflip(sensor,1);
    sensor->set_brightness(sensor,1);
    sensor->set_saturation(sensor,-2);
  }
  return true;
}

void startSetup() {
  if(setupMode)return;
  WiFi.mode(WIFI_AP_STA);
  uint32_t id=uint32_t(ESP.getEfuseMac()>>24);
  char suffix[12];snprintf(suffix,sizeof(suffix),"%06lX",(unsigned long)(id&0xFFFFFF));
  apName="Gettin-Figgy-"+String(suffix);
  setupMode=WiFi.softAP(apName.c_str(),"FiggySetup!");
  if(!setupMode){Serial.println("Setup AP failed to start; retrying in loop.");return;}
  Serial.printf("Setup Wi-Fi: %s / FiggySetup!\nOpen http://192.168.4.1\n",apName.c_str());
}

#ifndef FIGGY_EPISODE_002
// Figgy says: the live video server is for 001. In 002 we leave this out of
// the build so snapshots get the camera to themselves. Keep the code here
// for viewers who want to switch back — no deleting chunks of the project!
// Hold the camera lock for each complete frame. Always return the borrowed buffer.
esp_err_t streamHandler(httpd_req_t* req) {
  if(!cameraReady){httpd_resp_set_status(req,"503 Service Unavailable");return httpd_resp_sendstr(req,"Camera unavailable");}
  httpd_resp_set_type(req,"multipart/x-mixed-replace;boundary=figgyframe");
  httpd_resp_set_hdr(req,"Cache-Control","no-store");
  esp_err_t result=ESP_OK;
  while(result==ESP_OK){
    if(xSemaphoreTake(cameraLock,pdMS_TO_TICKS(4000))!=pdTRUE)break;
    camera_fb_t* fb=esp_camera_fb_get();
    if(!fb){xSemaphoreGive(cameraLock);break;}
    char header[100];
    int n=snprintf(header,sizeof(header),"--figgyframe\r\nContent-Type: image/jpeg\r\nContent-Length: %u\r\n\r\n",(unsigned)fb->len);
    result=httpd_resp_send_chunk(req,header,n);
    if(result==ESP_OK)result=httpd_resp_send_chunk(req,(const char*)fb->buf,fb->len);
    if(result==ESP_OK)result=httpd_resp_send_chunk(req,"\r\n",2);
    esp_camera_fb_return(fb);
    xSemaphoreGive(cameraLock);
    vTaskDelay(pdMS_TO_TICKS(40));
  }
  return ESP_FAIL; // close the socket on disconnect, capture failure, or lock timeout
}

#endif // 001 live video

void capture() {
  if(!cameraReady){web.send(503,"text/plain","Camera unavailable");return;}
  if(xSemaphoreTake(cameraLock,pdMS_TO_TICKS(4000))!=pdTRUE){web.send(503,"text/plain","Camera busy; try again");return;}
  camera_fb_t* fb=esp_camera_fb_get();
  if(!fb){xSemaphoreGive(cameraLock);web.send(503,"text/plain","Capture failed");return;}
  web.sendHeader("Cache-Control","no-store");
  web.sendHeader("Content-Disposition","attachment; filename=figgy-photo.jpg");
  web.send_P(200,"image/jpeg",(const char*)fb->buf,fb->len);
  esp_camera_fb_return(fb);
  xSemaphoreGive(cameraLock);
}


// The browser starts a scan, then polls while the radio works asynchronously.
// Scan results are available to dashboard clients; credential changes require setup Wi-Fi.
bool scanStarted = false;
String scanJson;
String jsonString(const String& value) {
  String result="\"";
  for(size_t i=0;i<value.length();++i){
    const uint8_t c=value[i];
    if(c=='"' || c=='\\'){result+='\\';result+=char(c);}
    else if(c<0x20){char escaped[7];snprintf(escaped,sizeof(escaped),"\\u%04x",c);result+=escaped;}
    else result+=char(c);
  }
  return result+'"';
}
bool setupClient() { return setupMode && web.client().localIP()==WiFi.softAPIP(); }
String authName(wifi_auth_mode_t auth) {
  switch(auth){
    case WIFI_AUTH_OPEN:return "Open";
    case WIFI_AUTH_WEP:return "WEP";
    case WIFI_AUTH_WPA_PSK:return "WPA-Personal";
    case WIFI_AUTH_WPA2_PSK:return "WPA2-Personal";
    case WIFI_AUTH_WPA_WPA2_PSK:return "WPA/WPA2-Personal";
    case WIFI_AUTH_WPA2_ENTERPRISE:return "WPA2-Enterprise";
    case WIFI_AUTH_WPA3_PSK:return "WPA3-Personal";
    case WIFI_AUTH_WPA2_WPA3_PSK:return "WPA2/WPA3-Personal";
    case WIFI_AUTH_WAPI_PSK:return "WAPI";
    case WIFI_AUTH_OWE:return "Enhanced Open (OWE)";
    case WIFI_AUTH_WPA3_ENT_192:return "WPA3-Enterprise 192-bit";
    case WIFI_AUTH_WPA3_EXT_PSK:return "WPA3-Personal";
    case WIFI_AUTH_WPA3_EXT_PSK_MIXED_MODE:return "WPA2/WPA3-Personal";
    case WIFI_AUTH_DPP:return "DPP";
    case WIFI_AUTH_WPA3_ENTERPRISE:return "WPA3-Enterprise";
    case WIFI_AUTH_WPA2_WPA3_ENTERPRISE:return "WPA2/WPA3-Enterprise";
    case WIFI_AUTH_WPA_ENTERPRISE:return "WPA-Enterprise";
    default:return "Unknown";
  }
}
void wifiScan() {
  web.sendHeader("Cache-Control","no-store");
  if(restartAt){web.send(409,"text/plain","Device is restarting.");return;}
  int count=WiFi.scanComplete();
  if(web.method()==HTTP_POST){
    if(web.header("X-Figgy-Setup")!="1"){web.send(403,"text/plain","Use the setup form on this device.");return;}
    if(count!=WIFI_SCAN_RUNNING){
      WiFi.scanDelete();scanJson="";
      count=WiFi.scanNetworks(true,true);
      scanStarted=true;
    }
  }else if(scanJson.length()){web.send(200,"application/json",scanJson);return;}
  else if(!scanStarted){web.send(409,"text/plain","Start a scan first.");return;}
  if(count==WIFI_SCAN_RUNNING){web.send(202,"application/json","{\"scanning\":true}");return;}
  if(count<0){scanStarted=false;web.send(503,"text/plain","The radio could not scan. Try again.");return;}
  // Bound the response, keeping the strongest 32 access points, including hidden SSIDs.
  int strongest[32];int used=0;
  for(int i=0;i<count;++i){
    int pos=used;
    while(pos>0 && WiFi.RSSI(i)>WiFi.RSSI(strongest[pos-1]))--pos;
    if(pos>=32)continue;
    if(used<32)++used;
    for(int j=used-1;j>pos;--j)strongest[j]=strongest[j-1];
    strongest[pos]=i;
  }
  scanJson="{\"networks\":[";
  for(int j=0;j<used;++j){
    int i=strongest[j];
    if(j)scanJson+=',';
    scanJson+="{\"ssid\":"+jsonString(WiFi.SSID(i))+",\"bssid\":"+jsonString(WiFi.BSSIDstr(i))+",\"channel\":"+String(WiFi.channel(i))+",\"security\":"+jsonString(authName(WiFi.encryptionType(i)))+",\"rssi\":"+String(WiFi.RSSI(i))+",\"open\":"+(WiFi.encryptionType(i)==WIFI_AUTH_OPEN?"true":"false")+"}";
  }
  scanJson+="]}";
  WiFi.scanDelete();scanStarted=false;
  web.send(200,"application/json",scanJson);
}

void setup() {
  Serial.begin(115200);
#ifdef FIGGY_EPISODE_002
  Serial.println("\nGettin Figgy episode 002 | computer object detection");
#else
  Serial.println("\nGettin Figgy episode 001 | camera dashboard");
#endif
  cameraLock=xSemaphoreCreateMutex();
  cameraReady=cameraLock && initCamera();
  if(!prefs.begin("figgy",false))Serial.println("Settings storage unavailable; setup remains accessible.");
  String ssid=prefs.getString("ssid","");
  String password=prefs.getString("password","");
  WiFi.mode(WIFI_STA);
  WiFi.setHostname("gettin-figgy");
  WiFi.setSleep(false);
  WiFi.setAutoReconnect(true);
  if(ssid.length()){
    WiFi.begin(ssid.c_str(),password.c_str());
    const uint32_t started=millis();
    while(WiFi.status()!=WL_CONNECTED && millis()-started<20000)delay(100);
  }
  if(WiFi.status()!=WL_CONNECTED)startSetup();
  else Serial.printf("Open http://%s\n",WiFi.localIP().toString().c_str());
  web.on("/",HTTP_GET,[]{web.sendHeader("Content-Encoding","gzip");web.send_P(200,"text/html; charset=utf-8",(const char*)index_html,sizeof(index_html));});
  web.on("/mark.svg",HTTP_GET,[]{web.sendHeader("Content-Encoding","gzip");web.send_P(200,"image/svg+xml",(const char*)brand_mark,sizeof(brand_mark));});
  web.on("/wordmark.webp",HTTP_GET,[]{web.send_P(200,"image/webp",(const char*)brand_wordmark,sizeof(brand_wordmark));});
  web.on("/capture",HTTP_GET,capture);
  web.on("/wifi/scan",HTTP_POST,wifiScan);
  web.on("/wifi/scan",HTTP_GET,wifiScan);
#ifdef FIGGY_EPISODE_002
  // Figgy says: one picture at a time, folks. The computer does the detecting!
  // This uses the SAME lock and buffer cleanup as Save photo. Don't make a
  // second camera init or keep a frame buffer after returning it to the driver.
  web.on("/detect.jpg",HTTP_GET,capture);
#endif
  web.on("/status",HTTP_GET,[]{
    web.sendHeader("Cache-Control","no-store");
    const bool connected=WiFi.status()==WL_CONNECTED;
    web.send(200,"application/json",String("{\"camera\":")+(cameraReady?"true":"false")+",\"detection\":"+(detectionMode?"true":"false")+",\"stream\":"+(streamReady?"true":"false")+",\"setup\":"+(setupMode?"true":"false")+",\"setup_access\":"+(setupClient()?"true":"false")+",\"connected\":"+(connected?"true":"false")+",\"ssid\":"+jsonString(connected?WiFi.SSID():apName)+",\"rssi\":"+(connected?String(WiFi.RSSI()):String("null"))+",\"ip\":\""+WiFi.localIP().toString()+"\"}");
  });
  web.on("/wifi",HTTP_POST,[]{
    if(!setupClient()){web.send(403,"text/plain","Join the device setup network to change Wi-Fi.");return;}
    if(web.header("X-Figgy-Setup")!="1"){web.send(403,"text/plain","Use the setup form on this device.");return;}
    if(restartAt){web.send(409,"text/plain","Device is restarting.");return;}
    String s=web.arg("ssid"),p=web.arg("password");
    if(s.length()<1 || s.length()>32 || (p.length()>0 && (p.length()<8 || p.length()>63))){web.send(400,"text/plain","Use a 1–32 byte network name and an 8–63 character password (or leave blank for an open network).");return;}
    if(prefs.putString("ssid",s)!=s.length() || prefs.putString("password",p)!=p.length() || prefs.getString("password","__unset__")!=p){web.send(500,"text/plain","Settings could not be saved. Try again.");return;}
    web.send(200,"text/plain","Saved. Reconnect to your home Wi-Fi after restart. Open http://gettin-figgy.local or find its IP in your router's device list / USB serial. If connection fails, rejoin the setup network.");
    restartAt=millis()+1500;
  });
  web.onNotFound([]{web.send(404,"text/plain","Not found");});
  const char* headers[]={"X-Figgy-Setup"};
  web.collectHeaders(headers,1);
  web.begin();
#ifndef FIGGY_EPISODE_002
  // Figgy says: 002 comments this whole live-server block out at compile time.
  // Leave the dashboard and capture routes above ON; setup still needs them!
  httpd_config_t config=HTTPD_DEFAULT_CONFIG();
  config.server_port=81;config.ctrl_port=32769;config.stack_size=6144;
  config.send_wait_timeout=3;config.recv_wait_timeout=3;config.lru_purge_enable=true;
  esp_err_t err=httpd_start(&streamServer,&config);
  if(err==ESP_OK){
    httpd_uri_t route={};route.uri="/stream";route.method=HTTP_GET;route.handler=streamHandler;
    err=httpd_register_uri_handler(streamServer,&route);
  }
  streamReady=(err==ESP_OK);
  if(!streamReady)Serial.printf("Stream server failed: 0x%x\n",err);
#endif
}

void loop() {
  web.handleClient();
  if(restartAt && (int32_t)(millis()-restartAt)>=0)ESP.restart();
  if(WiFi.status()!=WL_CONNECTED){
    if(!disconnectedAt)disconnectedAt=millis();
    if(millis()-disconnectedAt>30000)startSetup();
  }else {
    disconnectedAt=0;
    if(!mdnsStarted){mdnsStarted=MDNS.begin("gettin-figgy");if(mdnsStarted)MDNS.addService("http","tcp",80);}
  }
  delay(2);
}
